# Backend environment configuration.
# Copy to `backend/.env` for local development, or set these as environment
# variables in your host (e.g. Render). NEVER commit a filled-in .env — only
# this example is tracked. Secrets (SUPABASE_SERVICE_KEY, MAINTENANCE_TOKEN)
# must come from the environment and are never sent to the browser.

# ---------------------------------------------------------------------------
# Storage backend: "local" (default, v1.0.0 self-hosted) or "cloud" (Supabase).
# Leave as local for self-hosting; the public deployment sets this to cloud.
# ---------------------------------------------------------------------------
STORAGE_BACKEND=local

# ---------------------------------------------------------------------------
# Supabase Storage (ONLY needed when STORAGE_BACKEND=cloud)
#   SUPABASE_URL           : project URL, e.g. https://abcdxyz.supabase.co
#   SUPABASE_SERVICE_KEY   : service_role key (SECRET, server-side only)
#   SUPABASE_BUCKET        : storage bucket name (create it in the dashboard)
# ---------------------------------------------------------------------------
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=
# SUPABASE_BUCKET=projects

# ---------------------------------------------------------------------------
# CORS: origin of the deployed frontend (added to the built-in localhost dev
# origins). Example: https://your-project.pages.dev
# Required in the public deployment: the frontend sends credentials (the
# anonymous-session cookie), so the API must name the exact frontend origin —
# a wildcard origin is invalid alongside credentials.
# ---------------------------------------------------------------------------
# FRONTEND_ORIGIN=

# ---------------------------------------------------------------------------
# Anonymous per-browser project ownership (no login / no signup).
# Each browser is issued a random anonymous session id in an HttpOnly cookie,
# and a project is private to the browser that created it. Defaults need no
# changes for either the cloud deployment or localhost dev.
#
#   OWNERSHIP_MODE : auto (default) enforces ownership in cloud mode and leaves
#                    local/self-hosted mode unscoped (v1.0.0 behavior). Force
#                    with "on" or "off".
#   SESSION_COOKIE_NAME    : name of the HttpOnly session cookie (default fl_sid)
#   COOKIE_SAMESITE        : none (default; needed cross-site SPA<->API, requires
#                            Secure) | lax | strict (same-site / LAN self-host)
#   COOKIE_SECURE          : auto (default -> on; localhost still accepts it) |
#                            false (ONLY for plain-http self-host on a non-local host)
#   SESSION_COOKIE_MAX_AGE : cookie lifetime in seconds (default ~1 year)
# ---------------------------------------------------------------------------
# OWNERSHIP_MODE=auto
# SESSION_COOKIE_NAME=fl_sid
# COOKIE_SAMESITE=none
# COOKIE_SECURE=auto
# SESSION_COOKIE_MAX_AGE=31536000

# ---------------------------------------------------------------------------
# Abuse limits for anonymous public projects (safe defaults shown).
# ---------------------------------------------------------------------------
# MAX_UPLOAD_BYTES=10485760          # 10 MB per image
# MAX_IMAGES_PER_PROJECT=100
# MAX_PROJECT_BYTES=209715200        # 200 MB per project
# PROJECT_TTL_HOURS=30               # temp-project lifetime in hours (cloud only;
#                                    # 0 disables expiry. Never applied locally.)

# ---------------------------------------------------------------------------
# Maintenance/cleanup endpoint token (cloud only). When empty the endpoint is
# disabled. Set a long random value and have an external cron call:
#   POST /maintenance/cleanup  with header  X-Maintenance-Token: <this value>
# ---------------------------------------------------------------------------
# MAINTENANCE_TOKEN=
