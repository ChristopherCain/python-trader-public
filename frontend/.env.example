# Frontend environment configuration (Vite).
# Copy to `.env` for local development, or set in the Cloudflare Pages
# build environment for the public deployment. Only VITE_-prefixed vars are
# exposed to the browser bundle.

# Base URL of the FastAPI backend.
#   Local dev : leave unset to use http://127.0.0.1:8000 (the default), or set
#               it explicitly as below.
#   Production: set to your deployed backend origin, e.g.
#               https://forgotelabeling-api.onrender.com
# VITE_API_BASE_URL=http://127.0.0.1:8000

# Backward-compatible alias honored if VITE_API_BASE_URL is not set (v1.0.0).
# VITE_API_URL=http://127.0.0.1:8000
